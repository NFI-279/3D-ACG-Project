mtllib cube.mtl
o Cube

# ======================
# VERTEX POSITIONS
# ======================

# Front face
v -1 0  1
v  1 0  1
v  1 2  1
v -1 2  1

# Back face
v  1 0 -1
v -1 0 -1
v -1 2 -1
v  1 2 -1

# Left face
v -1 0 -1
v -1 0  1
v -1 2  1
v -1 2 -1

# Right face
v  1 0  1
v  1 0 -1
v  1 2 -1
v  1 2  1

# Top face
v -1 2  1
v  1 2  1
v  1 2 -1
v -1 2 -1

# Bottom face
v -1 0 -1
v  1 0 -1
v  1 0  1
v -1 0  1

# ======================
# UVs (FULL IMAGE PER FACE)
# ======================

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# repeated for each face
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# ======================
# NORMALS
# ======================

vn  0  0  1   # front
vn  0  0 -1   # back
vn -1  0  0   # left
vn  1  0  0   # right
vn  0  1  0   # top
vn  0 -1  0   # bottom

usemtl cubeTexture
s off

# ======================
# FACES
# ======================

# Front
f 1/1/1 2/2/1 3/3/1 4/4/1

# Back
f 5/5/2 6/6/2 7/7/2 8/8/2

# Left
f 9/9/3 10/10/3 11/11/3 12/12/3

# Right
f 13/13/4 14/14/4 15/15/4 16/16/4

# Top
f 17/17/5 18/18/5 19/19/5 20/20/5

# Bottom
f 21/21/6 22/22/6 23/23/6 24/24/6
